{
  "name": "fretflow",
  "private": true,
  "version": "1.0.0-alpha.2",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "desktop:pack": "npm run desktop:dist",
    "desktop:dist": "npm run build && node scripts/build-mac.cjs"
  },
  "build": {
    "appId": "com.fretflow.app",
    "productName": "FretFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FretFlow uses your microphone only while the guitar tuner is listening. Audio is processed locally."
      },
      "icon": "electron/icon.icns"
    }
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/jszip": "^3.4.0",
    "canvas-confetti": "^1.9.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "license": "GPL-3.0-only",
  "description": "Open-source guitar practice with notation, tablature, loops, tempo drills, and a local tuner.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Latexmanwebb/fretflow.git"
  },
  "bugs": {
    "url": "https://github.com/Latexmanwebb/fretflow/issues"
  },
  "homepage": "https://github.com/Latexmanwebb/fretflow#readme"
}
